{
  "name": "dsh-official-file-parse",
  "version": "0.2.0",
  "description": "Official DeepSeek document parsing (Files API) for DeepSeek Harness: parse PDF/Word/PowerPoint/images with figures and layout kept, then answer questions about them.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "document",
    "pdf",
    "document-parsing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fireqtian/dsh-official-file-parse.git"
  },
  "homepage": "https://github.com/Fireqtian/dsh-official-file-parse#readme",
  "bugs": {
    "url": "https://github.com/Fireqtian/dsh-official-file-parse/issues"
  },
  "author": "Fireqtian",
  "license": "MIT",
  "engines": {
    "node": "^20.3 || >=22"
  }
}
